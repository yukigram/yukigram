@@ -1809,6 +1807,7 @@ bool ListWidget::showCopyMediaRestriction(not_null<HistoryItem*> item) {
 }
 
 bool ListWidget::hasCopyRestrictionForSelected() const {
+	return false;
 	if (hasCopyRestriction()) {
 		return true;
 	}
@@ -1842,9 +1841,7 @@ bool ListWidget::showCopyRestrictionForSelected() {
 }
 
