diff --git a/Telegram/SourceFiles/yukigram/settings/audio_bitrate.cpp b/Telegram/SourceFiles/yukigram/settings/audio_bitrate.cpp
index 2f48c63bba..2673e97d21 100644
--- a/Telegram/SourceFiles/yukigram/settings/audio_bitrate.cpp
+++ b/Telegram/SourceFiles/yukigram/settings/audio_bitrate.cpp
@@ -16,6 +16,9 @@ constexpr auto kCallDefault = 32768;
 constexpr auto kGroupCallDefault = 32000;
 constexpr auto kMinDefault = 6000;
 constexpr auto kKbpsFrom = 16000;
+constexpr auto kFadeDefault = 300;
+constexpr auto kSkipDefault = 400;
+constexpr auto kMaxMs = 2000;
 
 static_assert(kMinBitrateBps == tgcalls::kAudioBitrateMinBps);
 static_assert(kMaxBitrateBps == tgcalls::kAudioBitrateMaxBps);
@@ -31,9 +34,13 @@ bool Syncing = false;
 std::optional<bool> LastPin;
 
 std::atomic<int> VoiceBps = kVoiceDefault;
+std::atomic<int> FadeMs = kFadeDefault;
+std::atomic<int> SkipMs = kSkipDefault;
 
 const auto bitrateCheckValid = Yukigram::Options::Valid::Bounded(kMinBitrateBps, kMaxBitrateBps);
 const auto bitrateValidHint = Yukigram::Options::Valid::BoundedHint(kMinBitrateBps, kMaxBitrateBps);
+const auto durationCheckValid = Yukigram::Options::Valid::Bounded(0, kMaxMs);
+const auto durationValidHint = Yukigram::Options::Valid::BoundedHint(0, kMaxMs);
 
 [[nodiscard]] int ClampBps(int value) {
 	return std::clamp(value, kMinBitrateBps, kMaxBitrateBps);
@@ -108,6 +115,8 @@ void Apply(Source source) {
 } // namespace
 
 const char kOptionVoiceBitrate[] = "voice-bitrate";
+const char kOptionVoiceFadeDuration[] = "voice-fade-duration";
+const char kOptionVoiceSkipDuration[] = "voice-skip-duration";
 const char kOptionCallAudioBitrate[] = "call-bitrate";
 const char kOptionGroupCallAudioBitrate[] = "group-call-bitrate";
 const char kOptionCallBitratePin[] = "call-bitrate-pin";
@@ -129,6 +138,24 @@ rpl::variable<int> *VoiceBitrate = Yukigram::Options::make<int>(kOptionVoiceBitr
 	},
 });
 
+rpl::variable<int> *VoiceFadeDuration = Yukigram::Options::make<int>(kOptionVoiceFadeDuration, {
+	.keywords = { u"yukigram"_q, u"audio"_q, u"voice"_q, u"fade"_q },
+	.category = "audio",
+	.defaultValue = kFadeDefault,
+	.link = [](int value) { FadeMs.store(value, std::memory_order_relaxed); },
+	.checkValid = durationCheckValid,
+	.validHint = durationValidHint,
+});
+
+rpl::variable<int> *VoiceSkipDuration = Yukigram::Options::make<int>(kOptionVoiceSkipDuration, {
+	.keywords = { u"yukigram"_q, u"audio"_q, u"voice"_q, u"skip"_q, u"mute"_q },
+	.category = "audio",
+	.defaultValue = kSkipDefault,
+	.link = [](int value) { SkipMs.store(value, std::memory_order_relaxed); },
+	.checkValid = durationCheckValid,
+	.validHint = durationValidHint,
+});
+
 rpl::variable<int> *CallAudioBitrate = Yukigram::Options::make<int>(kOptionCallAudioBitrate, {
 	.keywords = { u"yukigram"_q, u"audio"_q, u"opus"_q, u"bitrate"_q, u"call"_q },
 	.category = "audio",
@@ -219,4 +246,12 @@ void ResetAudioBitrate() {
 	Apply(Source::Pin);
 }
 
+crl::time VoiceFadeMs() {
+	return FadeMs.load(std::memory_order_relaxed);
+}
+
+crl::time VoiceSkipMs() {
+	return SkipMs.load(std::memory_order_relaxed);
+}
+
 } // namespace Yukigram::Settings
