diff --git a/Telegram/SourceFiles/yukigram/settings/bwe_meter.cpp b/Telegram/SourceFiles/yukigram/settings/bwe_meter.cpp
new file mode 100644
index 0000000000..10b974518d
--- /dev/null
+++ b/Telegram/SourceFiles/yukigram/settings/bwe_meter.cpp
@@ -0,0 +1,160 @@
+#include "yukigram/settings/bwe_meter.h"
+
+#include "yukigram/options.h"
+#include "settings/settings_builder.h"
+#include "styles/palette.h"
+#include "styles/style_settings.h"
+#include "lang/lang_keys.h"
+#include "yukigram/lang.h"
+#include "settings.h"
+
+#include "crl/crl_async.h"
+#include "crl/crl_time.h"
+#include <tgcalls/AudioBitrateBand.h>
+#include <tgcalls/SendBandwidthEstimate.h>
+
+#include <QtCore/QDateTime>
+#include <QtCore/QFile>
+#include <QtCore/QStringList>
+#include <QtGui/QDesktopServices>
+#include <QtCore/QUrl>
+
+#include <chrono>
+#include <mutex>
+
+namespace Yukigram::Calls {
+namespace {
+
+constexpr auto kStale = std::chrono::seconds(2);
+constexpr auto kRecoveredShown = crl::time(5000);
+constexpr auto kHistoryLines = 500;
+
+std::mutex HistoryMutex;
+
+struct State {
+	bool below = false;
+	crl::time recoveredUntil = 0;
+};
+
+[[nodiscard]] State &CurrentState() {
+	static auto state = State();
+	return state;
+}
+
+[[nodiscard]] QString HistoryPath() {
+	return cWorkingDir() + u"yukigram-bwe-history.log"_q;
+}
+
+void AppendDrop(int bps, int mainBps) {
+	const auto line = u"%1  BWE %2 bps fell below main %3 bps"_q
+		.arg(QDateTime::currentDateTime().toString(u"yyyy-MM-dd HH:mm:ss"_q))
+		.arg(bps)
+		.arg(mainBps);
+	crl::async([=] {
+		const auto guard = std::lock_guard(HistoryMutex);
+		auto lines = QStringList();
+		auto file = QFile(HistoryPath());
+		if (file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+			lines = QString::fromUtf8(file.readAll()).split(
+				u'\n',
+				Qt::SkipEmptyParts);
+			file.close();
+		}
+		lines.push_back(line);
+		if (lines.size() > kHistoryLines) {
+			lines = lines.mid(lines.size() - kHistoryLines);
+		}
+		if (file.open(QIODevice::WriteOnly
+				| QIODevice::Truncate
+				| QIODevice::Text)) {
+			file.write((lines.join(u'\n') + u'\n').toUtf8());
+		}
+	});
+}
+
+} // namespace
+
+const char kOptionBweShow[] = "bwe-show";
+const char kOptionBweLog[] = "bwe-log";
+
+rpl::variable<bool> *BweShow = Yukigram::Options::make<bool>(kOptionBweShow, {
+	.keywords = { u"yukigram"_q, u"audio"_q, u"bandwidth"_q, u"bwe"_q, u"call"_q },
+	.category = "audio",
+});
+
+rpl::variable<bool> *BweLog = Yukigram::Options::make<bool>(kOptionBweLog, {
+	.keywords = { u"yukigram"_q, u"audio"_q, u"bandwidth"_q, u"bwe"_q, u"history"_q },
+	.category = "audio",
+});
+
+BweView CurrentBweView() {
+	const auto estimate = tgcalls::LastSendBandwidthEstimate();
+	auto &state = CurrentState();
+	if (!estimate
+		|| estimate->bps <= 0
+		|| std::chrono::steady_clock::now() - estimate->at > kStale) {
+		state = State();
+		return {};
+	}
+	const auto bps = estimate->bps;
+	const auto mainBps = tgcalls::AudioBitrateBand().mainBps.load();
+	const auto now = crl::now();
+
+	auto color = std::optional<QColor>();
+	if (bps < mainBps) {
+		if (!state.below && BweLog->current()) {
+			AppendDrop(bps, mainBps);
+		}
+		state.below = true;
+		state.recoveredUntil = 0;
+		color = st::boxTextFgError->c;
+	} else {
+		if (state.below) {
+			state.below = false;
+			state.recoveredUntil = now + kRecoveredShown;
+		}
+		if (state.recoveredUntil > now) {
+			color = st::boxTextFgGood->c;
+		}
+	}
+	if (!BweShow->current()) {
+		return {};
+	}
+	return {
+		.visible = true,
+		.text = u"BWE %1"_q.arg(bps),
+		.color = color,
+	};
+}
+
+void AddBweHistoryButtons(::Settings::Builder::SectionBuilder &builder) {
+	builder.addButton({
+		.id = u"yukigram/bwe-history-open"_q,
+		.title = rktr("settings/bwe/history/open/title"),
+		.st = &st::settingsButtonNoIcon,
+		.onClick = [] {
+			const auto path = HistoryPath();
+			{
+				const auto guard = std::lock_guard(HistoryMutex);
+				auto file = QFile(path);
+				if (!file.exists() && !file.open(QIODevice::WriteOnly)) {
+					return;
+				}
+			}
+			QDesktopServices::openUrl(QUrl::fromLocalFile(path));
+		},
+		.keywords = { u"yukigram"_q, u"bwe"_q, u"history"_q },
+	});
+	builder.addButton({
+		.id = u"yukigram/bwe-history-clear"_q,
+		.title = rktr("settings/bwe/history/clear/title"),
+		.st = &st::settingsButtonNoIcon,
+		.onClick = [] {
+			const auto guard = std::lock_guard(HistoryMutex);
+			QFile::remove(HistoryPath());
+		},
+		.keywords = { u"yukigram"_q, u"bwe"_q, u"history"_q },
+	});
+}
+
+} // namespace Yukigram::Calls
