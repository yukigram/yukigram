+
+void Panel::refreshBwe() {
+	if (!_subtitle) {
+		_bwe.destroy();
+		_bweTimer.cancel();
+		return;
+	}
+	if (!_bweTimer.isActive()) {
+		_bweTimer.setCallback([=] { refreshBwe(); });
+		_bweTimer.callEach(crl::time(500));
+	}
+	const auto view = Yukigram::Calls::CurrentBweView();
+	if (!view.visible) {
+		if (_bwe) {
+			_bwe->hide();
+		}
+		return;
+	}
+	if (!_bwe) {
+		_bwe.create(widget(), st::groupCallSubtitleLabel);
+		_bwe->setAttribute(Qt::WA_TransparentForMouseEvents);
+	}
+	_bwe->setText(view.text);
+	_bwe->setTextColorOverride(view.color);
+	_bwe->resizeToNaturalWidth(_bwe->textMaxWidth());
+	const auto top = (_title
+		? st::groupCallSubtitleTop
+		: st::groupCallTitleTop) + _subtitle->height();
+	const auto left = Platform::WindowTitleAlignsLeft()
+		? computeTitleRect().x()
+		: (widget()->width() - _bwe->width()) / 2;
+	_bwe->moveToLeft(left, top);
+	_bwe->show();
 }
 
