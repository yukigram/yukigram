@@ -0,0 +1,44 @@
+#ifndef TGCALLS_SEND_BANDWIDTH_ESTIMATE_H
+#define TGCALLS_SEND_BANDWIDTH_ESTIMATE_H
+
+#include <chrono>
+#include <mutex>
+#include <optional>
+
+namespace tgcalls {
+
+struct SendBandwidthEstimate {
+    int bps = 0;
+    std::chrono::steady_clock::time_point at;
+};
+
+namespace details {
+
+inline std::mutex &SendBandwidthMutex() {
+    static std::mutex mutex;
+    return mutex;
+}
+
+inline std::optional<SendBandwidthEstimate> &SendBandwidthValue() {
+    static std::optional<SendBandwidthEstimate> value;
+    return value;
+}
+
+} // namespace details
+
+inline void NoteSendBandwidthEstimate(int bps) {
+    const auto guard = std::lock_guard(details::SendBandwidthMutex());
+    details::SendBandwidthValue() = SendBandwidthEstimate{
+        .bps = bps,
+        .at = std::chrono::steady_clock::now(),
+    };
+}
+
+[[nodiscard]] inline std::optional<SendBandwidthEstimate> LastSendBandwidthEstimate() {
+    const auto guard = std::lock_guard(details::SendBandwidthMutex());
+    return details::SendBandwidthValue();
+}
+
+} // namespace tgcalls
+
+#endif // TGCALLS_SEND_BANDWIDTH_ESTIMATE_H
