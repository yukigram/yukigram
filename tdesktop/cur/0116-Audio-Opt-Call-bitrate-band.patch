+rpl::variable<int> *GroupCallAudioBitrate = Yukigram::Options::make<int>(kOptionGroupCallAudioBitrate, {
+	.keywords = { u"yukigram"_q, u"audio"_q, u"opus"_q, u"bitrate"_q, u"group"_q, u"call"_q },
+	.category = "audio",
+	.defaultValue = kGroupCallDefault,
+	.checkValid = bitrateCheckValid,
+	.validHint = bitrateValidHint,
+	.slider = Yukigram::Options::Slider{
+		.min = kMinBitrateBps,
+		.max = kMaxBitrateBps,
+		.logarithmic = true,
+		.format = FormatBitrate,
