diff --git a/Telegram/ThirdParty/tgcalls/tgcalls/AudioBitrateBand.h b/Telegram/ThirdParty/tgcalls/tgcalls/AudioBitrateBand.h
new file mode 100644
index 0000000000..d83f5ecd39
--- /dev/null
+++ b/Telegram/ThirdParty/tgcalls/tgcalls/AudioBitrateBand.h
@@ -0,0 +1,70 @@
+#ifndef TGCALLS_AUDIO_BITRATE_BAND_H
+#define TGCALLS_AUDIO_BITRATE_BAND_H
+
+#include <algorithm>
+#include <atomic>
+#include <list>
+#include <mutex>
+#include <string>
+
+namespace tgcalls {
+
+inline constexpr int kAudioBitrateMinBps = 500;
+inline constexpr int kAudioBitrateMaxBps = 256000;
+
+struct AudioBitrateBandState {
+    std::atomic<int> minBps{32768};
+    std::atomic<int> mainBps{32768};
+    std::atomic<int> maxBps{32768};
+};
+
+inline AudioBitrateBandState &AudioBitrateBand() {
+    static AudioBitrateBandState state;
+    return state;
+}
+
+inline void SetAudioBitrateBand(int minBps, int mainBps, int maxBps) {
+    auto &state = AudioBitrateBand();
+    state.minBps.store(minBps);
+    state.mainBps.store(mainBps);
+    state.maxBps.store(maxBps);
+}
+
+inline int AudioBitrateBandKbps(int bps) {
+    return std::max(1, (bps + 500) / 1000);
+}
+
+// WebRTC retains the raw char* pointer across threads, so keep strings alive.
+inline const char *YukigramAudioFieldTrials(const std::string &original) {
+    static std::mutex mutex;
+    static std::list<std::string> storage;
+
+    auto base = original;
+    const auto key = std::string("WebRTC-Audio-Allocation/");
+    const auto pos = base.find(key);
+    if (pos != std::string::npos) {
+        const auto end = base.find('/', pos + key.size());
+        if (end != std::string::npos) {
+            base.erase(pos, end + 1 - pos);
+        }
+    }
+    const auto minBps = AudioBitrateBand().minBps.load();
+    const auto maxBps = std::max(minBps, AudioBitrateBand().maxBps.load());
+    const auto result = "WebRTC-Audio-Allocation/min:"
+        + std::to_string(minBps) + "bps,max:"
+        + std::to_string(maxBps) + "bps/"
+        + base;
+
+    const auto guard = std::lock_guard(mutex);
+    for (const auto &existing : storage) {
+        if (existing == result) {
+            return existing.c_str();
+        }
+    }
+    storage.push_back(result);
+    return storage.back().c_str();
+}
+
+} // namespace tgcalls
+
+#endif // TGCALLS_AUDIO_BITRATE_BAND_H
