+
+rpl::variable<bool> *CallBitratePin = Yukigram::Options::make<bool>(kOptionCallBitratePin, {
+	.keywords = { u"yukigram"_q, u"audio"_q, u"opus"_q, u"bitrate"_q, u"pin"_q },
+	.category = "audio",
