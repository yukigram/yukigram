 #include "yukigram/options.h"
 
-#include <atomic>
+#include <tgcalls/AudioBitrateBand.h>
+
 #include <algorithm>
+#include <atomic>
+#include <optional>
 
 namespace Yukigram::Settings {
 namespace {
 
 constexpr auto kVoiceDefault = 32000;
+constexpr auto kCallDefault = 32768;
+constexpr auto kGroupCallDefault = 32000;
+constexpr auto kMinDefault = 6000;
 constexpr auto kKbpsFrom = 16000;
 
+static_assert(kMinBitrateBps == tgcalls::kAudioBitrateMinBps);
+static_assert(kMaxBitrateBps == tgcalls::kAudioBitrateMaxBps);
+
+enum class Source {
+	Main,
+	Min,
+	Max,
+	Pin,
+};
+
+bool Syncing = false;
+std::optional<bool> LastPin;
+
 std::atomic<int> VoiceBps = kVoiceDefault;
 
 const auto bitrateCheckValid = Yukigram::Options::Valid::Bounded(kMinBitrateBps, kMaxBitrateBps);
@@ -26,9 +45,74 @@ const auto bitrateValidHint = Yukigram::Options::Valid::BoundedHint(kMinBitrateB
 	}
 	return QString::number(bps / 1000., 'g', 3) + u" kbps"_q;
 }
+
+void Apply(Source source) {
+	if (Syncing
+		|| !CallAudioBitrate
+		|| !CallBitrateMin
+		|| !CallBitrateMax
+		|| !CallBitratePin) {
+		return;
+	}
+	Syncing = true;
+
+	auto mainBps = ClampBps(CallAudioBitrate->current());
+	auto minBps = ClampBps(CallBitrateMin->current());
+	auto maxBps = ClampBps(CallBitrateMax->current());
+	const auto pin = CallBitratePin->current();
+	const auto justUnpinned = (source == Source::Pin)
+		&& LastPin.value_or(false)
+		&& !pin;
+	LastPin = pin;
+
+	if (pin) {
+		minBps = maxBps = mainBps;
+	} else if (justUnpinned) {
+		minBps = std::min(kMinDefault, mainBps);
+		maxBps = mainBps;
+	} else if (source == Source::Min) {
+		mainBps = std::max(mainBps, minBps);
+	} else if (source == Source::Max) {
+		mainBps = std::min(mainBps, maxBps);
+		minBps = std::min(minBps, maxBps);
+	}
+	if (!pin) {
+		minBps = std::min(minBps, mainBps);
+		maxBps = std::max(maxBps, mainBps);
+	}
+
+	*CallBitrateMin = minBps;
+	*CallBitrateMax = maxBps;
+	*CallAudioBitrate = mainBps;
+	Syncing = false;
+}
+
+[[nodiscard]] AudioBitrateBand Publish(int mainBps, bool stretch) {
+	auto band = AudioBitrateBand{
+		.minBps = ClampBps(CallBitrateMin->current()),
+		.mainBps = ClampBps(mainBps),
+		.maxBps = ClampBps(CallBitrateMax->current()),
+	};
+	if (CallBitratePin->current()) {
+		band.minBps = band.maxBps = band.mainBps;
+	} else if (stretch) {
+		band.minBps = std::min(band.minBps, band.mainBps);
+		band.maxBps = std::max(band.maxBps, band.mainBps);
+	} else {
+		band.mainBps = std::clamp(band.mainBps, band.minBps, band.maxBps);
+	}
+	tgcalls::SetAudioBitrateBand(band.minBps, band.mainBps, band.maxBps);
+	return band;
+}
+
 } // namespace
 
 const char kOptionVoiceBitrate[] = "voice-bitrate";
