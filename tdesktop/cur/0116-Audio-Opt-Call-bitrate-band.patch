+
+void ResetAudioBitrate() {
+	Syncing = true;
+	*VoiceBitrate = kVoiceDefault;
+	*GroupCallAudioBitrate = kGroupCallDefault;
+	*CallBitratePin = true;
+	*CallBitrateMin = kCallDefault;
+	*CallBitrateMax = kCallDefault;
+	*CallAudioBitrate = kCallDefault;
+	Syncing = false;
+	Apply(Source::Pin);
+}
+
 } // namespace Yukigram::Settings
