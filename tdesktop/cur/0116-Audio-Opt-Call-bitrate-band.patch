+
+rpl::variable<int> *CallBitrateMax = Yukigram::Options::make<int>(kOptionCallBitrateMax, {
+	.keywords = { u"yukigram"_q, u"audio"_q, u"opus"_q, u"bitrate"_q, u"max"_q },
+	.category = "audio",
+	.defaultValue = kCallDefault,
+	.link = [](int) { Apply(Source::Max); },
+	.checkValid = bitrateCheckValid,
+	.validHint = bitrateValidHint,
+	.slider = Yukigram::Options::Slider{
+		.min = kMinBitrateBps,
+		.max = kMaxBitrateBps,
+		.logarithmic = true,
+		.format = FormatBitrate,
+	},
+});
+
 int VoiceMessageBitrateBps() {
 	return ClampBps(VoiceBps.load(std::memory_order_relaxed));
 }
 
+AudioBitrateBand PublishCallBand() {
