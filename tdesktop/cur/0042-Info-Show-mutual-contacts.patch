From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lunya <241520024+lunya-miaou@users.noreply.github.com>
Date: Sun, 3 May 2026 12:59:23 +0000
Subject: [PATCH] (Info) Show mutual contacts


diff --git a/Telegram/SourceFiles/boxes/contacts_box.cpp b/Telegram/SourceFiles/boxes/contacts_box.cpp
index af2d4f5929..0c533e9ee2 100644
--- a/Telegram/SourceFiles/boxes/contacts_box.cpp
+++ b/Telegram/SourceFiles/boxes/contacts_box.cpp
@@ -44,9 +44,15 @@ public:
 		int y,
 		int outerWidth) override;
 
+	QSize rightActionSize() const override;
+	QMargins rightActionMargins() const override;
+	bool rightActionDisabled() const override;
+	void rightActionPaint(Painter &p, int x, int y, int outerWidth, bool selected, bool actionSelected) override;
+
 private:
 	const Fn<bool()> _selecting;
 	Ui::RoundCheckbox _check;
+	bool _isMutual = false;
 
 };
 
@@ -56,7 +62,8 @@ SelectableContactRow::SelectableContactRow(
 	Fn<void(not_null<PeerListRow*>)> repaint)
 : PeerListRow(user)
 , _selecting(std::move(selecting))
-, _check(st::defaultPeerListCheck, [=] { repaint(this); }) {
+, _check(st::defaultPeerListCheck, [=] { repaint(this); })
+, _isMutual(user->flags() & UserDataFlag::MutualContact) {
 	_check.setDisplayInactive(true);
 }
 
@@ -81,6 +88,30 @@ void SelectableContactRow::paintUserpicOverlay(
 	_check.paint(p, x + shift, y + shift, outerWidth);
 }
 
+QSize SelectableContactRow::rightActionSize() const {
+	return QSize(
+		st::menuIconGroups.width(),
+		st::menuIconGroups.height());
+}
+
+QMargins SelectableContactRow::rightActionMargins() const {
+	return QMargins(
+		st::contactsCheckPosition.x(),
+		(st::contactsPadding.top() + st::contactsPhotoSize + st::contactsPadding.bottom() - rightActionSize().height()) / 2,
+		st::defaultPeerListItem.photoPosition.x() + st::contactsCheckPosition.x(),
+		0);
+}
+
+bool SelectableContactRow::rightActionDisabled() const {
+	return true;
+}
+
+void SelectableContactRow::rightActionPaint(Painter &p, int x, int y, int outerWidth, bool selected, bool actionSelected) {
+	if (_isMutual) {
+		st::menuIconGroups.paint(p, x, y, outerWidth);
+	}
+}
+
 class ContactsListController final
 	: public ContactsBoxController
 	, public base::has_weak_ptr {
